{
  "name": "sap-notes-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "SAP Notes MCP server packaged as a one-click .mcpb bundle for Claude Desktop (fork of marianfoo/sap-mcp-servers).",
  "license": "Apache-2.0",
  "author": "marianfoo",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aamelin1/sap-notes-mcp.git"
  },
  "homepage": "https://github.com/aamelin1/sap-notes-mcp#readme",
  "bugs": {
    "url": "https://github.com/aamelin1/sap-notes-mcp/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/auth",
    "packages/notes"
  ],
  "scripts": {
    "build": "npm run build -w @marianfoo/sap-mcp-auth && npm run build -w sap-note-search-mcp",
    "clean": "npm run clean --workspaces --if-present",
    "test": "npm run test -w sap-note-search-mcp",
    "install:browsers": "playwright install chromium",
    "build:mcpb": "packages/notes/mcpb/build-mcpb.sh"
  },
  "devDependencies": {
    "rimraf": "^6.0.0",
    "typescript": "^6.0.3"
  }
}
