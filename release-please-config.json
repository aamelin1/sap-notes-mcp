{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "include-component-in-tag": true,
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance Improvements" },
    { "type": "revert", "section": "Reverts" },
    { "type": "deps", "section": "Dependencies" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "chore", "hidden": true },
    { "type": "ci", "hidden": true },
    { "type": "refactor", "hidden": true },
    { "type": "style", "hidden": true },
    { "type": "test", "hidden": true },
    { "type": "build", "hidden": true }
  ],
  "packages": {
    "packages/auth": {
      "release-type": "node",
      "component": "sap-mcp-auth",
      "package-name": "@marianfoo/sap-mcp-auth",
      "release-as": "0.1.1"
    },
    "packages/api-hub": {
      "release-type": "node",
      "component": "sap-api-hub-mcp",
      "package-name": "sap-api-hub-mcp",
      "release-as": "0.1.2"
    },
    "packages/roadmap": {
      "release-type": "node",
      "component": "sap-roadmap-mcp",
      "package-name": "sap-roadmap-mcp",
      "release-as": "0.1.2"
    },
    "packages/notes": {
      "release-type": "node",
      "component": "sap-note-search-mcp",
      "package-name": "sap-note-search-mcp",
      "release-as": "0.3.2"
    }
  }
}
